# ==============================================================================
# RouteWise Environment Configuration Template (.env.example)
# Copy to .env and configure values before starting the application.
# ==============================================================================

# ------------------------------------------------------------------------------
# Security & Authentication Secrets (MANDATORY)
# ------------------------------------------------------------------------------
# Cryptographically strong secret key used for HMAC-SHA256 bearer tokens.
# Must be at least 32 characters long. The application will refuse to start if missing,
# too short (<32 chars), or set to known defaults / placeholders.
# Generate on Linux/macOS/Windows with:
#   python -c "import secrets; print(secrets.token_hex(32))"
ROUTEWISE_SECRET_KEY=change-me-generate-with-python-secrets-token-hex-32

# Token Expiry Durations (in hours)
ROUTEWISE_TOKEN_EXPIRE_HOURS=72
ROUTEWISE_GUEST_EXPIRE_HOURS=12

# Demo Evaluation Mode Flag (true enables /api/v1/auth/demo-accounts listing)
ROUTEWISE_DEMO_MODE=false

# Demo Account Passwords (used when running: python -m app.seed_demo)
# Set your own secure demo passwords; must not be committed to git.
DEMO_PATROL_PASSWORD=change-me-patrol-password-min-8-chars
DEMO_USER_PASSWORD=change-me-user-password-min-8-chars

# ------------------------------------------------------------------------------
# Server Hosting & CORS
# ------------------------------------------------------------------------------
ROUTEWISE_HOST=127.0.0.1
ROUTEWISE_PORT=8000
ROUTEWISE_DEBUG=false
ROUTEWISE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:8000

# ------------------------------------------------------------------------------
# File Uploads & Storage Limits
# ------------------------------------------------------------------------------
ROUTEWISE_MAX_UPLOAD_BYTES=5242880
ROUTEWISE_UPLOADS_DIR=data/uploads

# ------------------------------------------------------------------------------
# Data and Artifact Paths (Relative to repository root or absolute)
# ------------------------------------------------------------------------------
ROUTEWISE_CACHE_PATH=cache/precomputed_risk_cache.json
ROUTEWISE_GRAPH_PATH=nh44_corridor_graph.graphml
ROUTEWISE_STATIC_PATH=data/segment_static.csv
ROUTEWISE_CHECKPOINT_PATH=stgnn_best.pt
ROUTEWISE_DB_PATH=data/routewise_local.db
ROUTEWISE_DISRUPTIONS_PATH=data/disruption_log_snapped.csv
ROUTEWISE_PLACES_PATH=data/place_coordinates.csv
ROUTEWISE_WEATHER_PATH=data/weather_daily_by_segment.csv

# ------------------------------------------------------------------------------
# External API Keys (Optional)
# ------------------------------------------------------------------------------
# Google Gemini API key for the conversational corridor assistant
# Obtain from https://aistudio.google.com/
GEMINI_API_KEY=

# OpenTopography API key for SRTM elevation data download (used by week1 pipeline)
# Obtain from https://portal.opentopography.org/
OPENTOPO_API_KEY=

# NOTE: OPENAI_API_KEY is not used by RouteWise (assistant uses Google Gemini or built-in engine).
# NOTE: Copernicus CDS API credentials for ERA5-Land weather download belong in ~/.cdsapirc, outside this repository.
